<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="OpenAI" Version="2.13.0" />
    <PackageReference Include="Qdrant.Client" Version="1.19.0" />
  </ItemGroup>
  <ItemGroup>
  <Compile Remove="MyLlmApp.Api\**\*" />
  <Content Remove="MyLlmApp.Api\**\*" />
  <EmbeddedResource Remove="MyLlmApp.Api\**\*" />
  <None Remove="MyLlmApp.Api\**\*" />

  <Compile Remove="MyLlmApp.Core\**\*" />
  <Content Remove="MyLlmApp.Core\**\*" />
  <EmbeddedResource Remove="MyLlmApp.Core\**\*" />
  <None Remove="MyLlmApp.Core\**\*" />
</ItemGroup>
  <ItemGroup>
    <ProjectReference Include="MyLlmApp.Core\MyLlmApp.Core.csproj" />
  </ItemGroup>

</Project>
